# Copy to .env and adjust. Never commit the real .env.
PORT=4000
# Public URL of this service; used as the JWT "iss" claim
AUTH_ISSUER=http://localhost:4000
# Audience the resource servers expect ("aud" claim)
AUTH_AUDIENCE=aroma-api
# Frontend origin allowed by CORS (credentials are enabled for this origin only)
CORS_ORIGIN=http://localhost:5173
# SQLite file (created on first run)
AUTH_DB_PATH=./data/auth.db
# RSA key pair folder (generated on first run, git-ignored)
AUTH_KEYS_DIR=./keys
# Token lifetimes
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
# bcrypt work factor (12 in production)
BCRYPT_COST=12
# Set to false only if your browser refuses Secure cookies on http://localhost
COOKIE_SECURE=true
