# Copy to .env and adjust. Never commit the real .env.
PORT=5000
# Where to download the auth-service public keys
AUTH_JWKS_URL=http://localhost:4000/.well-known/jwks.json
# Must match the auth-service AUTH_ISSUER / AUTH_AUDIENCE
AUTH_ISSUER=http://localhost:4000
AUTH_AUDIENCE=aroma-api
# How long fetched public keys are trusted without re-downloading (ms)
JWKS_CACHE_MAX_AGE_MS=600000
CORS_ORIGIN=http://localhost:5173
ORDERS_DB_PATH=./data/orders.db
